# Runtime
NODE_ENV=development
PORT=3001
TZ=America/Sao_Paulo

# Database
DATABASE_URL=postgresql://forja:forja@localhost:5432/forja_selvagem
DATABASE_SSL=false

# Auth (JWT_SECRET is required in production, minimum 32 characters)
JWT_SECRET=dev-only-secret-change-me-please-32-bytes-minimum
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3000

# Admin bootstrap (used from Phase 1 onward)
ADMIN_EMAIL=admin@forjaselvagem.local
ADMIN_DISPLAY_NAME=Administrador
ADMIN_INITIAL_PASSWORD=

# Storage
STORAGE_PATH=./storage
STORAGE_MAX_BYTES=1073741824
STORAGE_MAX_FILE_BYTES=5242880

# Migrations / seed
RUN_MIGRATIONS=true
RUN_SEED=false

# Rate limit (used from Phase 1 onward)
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# WebSocket (used from Phase 5 onward)
WS_CORS_ORIGIN=http://localhost:3000

# Logs
LOG_LEVEL=debug
SQL_LOG=false

# Sentry (optional in development)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Backups (used by operational scripts)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=forja-selvagem-backups
