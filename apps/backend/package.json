{
  "name": "@forja/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API da plataforma Forja Selvagem",
  "license": "MIT",
  "scripts": {
    "build": "nest build && npm run build:migrations",
    "build:migrations": "tsc -p tsconfig.migrations.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm",
    "db:migrate": "npm run build:migrations && typeorm migration:run -d dist/infrastructure/persistence/datasource.js",
    "db:migrate:revert": "typeorm migration:revert -d dist/infrastructure/persistence/datasource.js",
    "db:migrate:dev": "tsx ./node_modules/typeorm/cli.js migration:run -d src/infrastructure/persistence/datasource.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate src/infrastructure/persistence/datasource.ts -n",
    "db:seed": "node dist/infrastructure/seed/index.js",
    "db:seed:dev": "tsx src/infrastructure/seed/index.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/typeorm": "^12.0.3",
    "dotenv": "^18.0.10",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
