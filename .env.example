# ──────────────────────────────────────────────────────────────────────────────
# Docker Compose (root)
# Copy to `.env` for local development: cp .env.example .env
# App-specific examples: apps/backend/.env.example and apps/web/.env.example
# ──────────────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=forja
POSTGRES_PASSWORD=forja
POSTGRES_DB=forja_selvagem
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3001
DATABASE_URL=postgresql://forja:forja@postgres:5432/forja_selvagem
DATABASE_SSL=false
JWT_SECRET=dev-only-secret-change-me-please-32-bytes-minimum
CORS_ORIGIN=http://localhost:3000
RUN_MIGRATIONS=true
RUN_SEED=false
STORAGE_PATH=/app/storage
STORAGE_MAX_BYTES=1073741824
LOG_LEVEL=debug
SQL_LOG=false

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME=Forja Selvagem
